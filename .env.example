# ============================================================
# EDX CRM WEB FOV - ENVIRONMENT CONFIGURATION
# ============================================================

# SUPABASE CONFIGURATION (REQUIRED)
# Your Supabase project URL and anonymous key
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# OPTIONAL: Gemini AI API Key (for AI assistant features)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="your-gemini-api-key"

# OPTIONAL: Application URL
# Used for OAuth callbacks and email redirects
# In development: http://localhost:3000
# In production: your actual domain
APP_URL="http://localhost:3000"

# ============================================================
# SETUP INSTRUCTIONS
# ============================================================
# 1. Create a Supabase project at https://supabase.com
# 2. Copy this file to .env.local
# 3. Fill in your Supabase URL and anon key
# 4. Run the SQL schema from src/services/supabase-schema.sql in Supabase SQL Editor
# 5. Enable Google OAuth in Supabase Auth settings (optional)
# 6. Configure email templates in Supabase Auth (optional)
# ============================================================
